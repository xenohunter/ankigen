{
"word-pet": [{"t":"Van otthon {háziállatod}?"},{"t":"Amerikában a kutyák a legnépszerűbb {háziállatok}."},{"t":"Ebbe az épületbe tilos {háziállatot} bevinni."}],
"word-puppy": [{"t":"A szomszédaink most vettek egy {kiskutyát}."},{"t":"A {kiskutya} megrágta a cipőmet."},{"t":"A {kiskutyát} Maxnek nevezte el."}],
"word-kitten": [{"t":"A {kiscica} a kanapén alszik."},{"t":"Egy {kiscicát} találtunk a kertben."},{"t":"A {kiscicák} egy gombolyag fonallal játszottak."}],
"word-hamster": [{"t":"A lányomnak van egy Mogyoró nevű {hörcsöge}."},{"t":"A {hörcsög} egész éjjel fut a kerekében."},{"t":"A {hörcsögök} szeretik az arcukban tárolni az ételt."}],
"word-parrot": [{"t":"A {papagáj} tud köszönni."},{"t":"Egy zöld {papagáj} ült a vállán."},{"t":"Egyes {papagájok} ötvennél több évig élnek."}],
"word-guinea-pig": [{"t":"Vettünk egy {tengerimalacot} a fiamnak."},{"t":"A {tengerimalac} répát és szénát eszik."},{"t":"A {tengerimalacok} barátságosak és csendesek."}],
"word-turtle": [{"t":"A {teknős} behúzta a fejét a páncéljába."},{"t":"A {teknős} nagyon lassan mozog."},{"t":"Egy tengeri {teknőst} láttunk a parton."}],
"word-goldfish": [{"t":"A vásáron nyert egy {aranyhalat}."},{"t":"Az {aranyhal} körbeúszik a tálban."},{"t":"Ne etesd túl sokat az {aranyhalat}."}],
"word-aquarium": [{"t":"Egy nagy {akváriumban} tart trópusi halakat."},{"t":"Szombaton meglátogattuk az {akváriumot}."},{"t":"Hetente egyszer tisztítsd ki az {akváriumot}."}],
"word-cage": [{"t":"A madár a {ketrecében} van."},{"t":"Kérlek, csukd be a {ketrec} ajtaját."},{"t":"A hörcsög megszökött a {ketrecéből}."}],
"word-leash": [{"t":"Kérlek, tartsd a kutyádat {pórázon}."},{"t":"Szorosan fogta a {pórázt}."},{"t":"Elfelejtettem elhozni a {pórázt}."}],
"word-collar": [{"t":"A kutyán piros {nyakörv} van."},{"t":"A neve rajta van a {nyakörvön}."},{"t":"A macska {nyakörvén} egy kis csengő van."}],
"word-pet-food": [{"t":"Több {állateledelt} kell vennünk."},{"t":"Ez az {állateledel} idősebb kutyáknak készült."},{"t":"Az {állateledelt} egy szekrényben tartja."}],
"word-vet": [{"t":"Elvittük a macskát az {állatorvoshoz}."},{"t":"Az {állatorvos} azt mondta, hogy a kutya egészséges."},{"t":"A húgom {állatorvos} szeretne lenni."}],
"word-vaccination": [{"t":"A kiskutyának {oltásra} van szüksége."},{"t":"A kutyáknak kötelező a veszettség elleni {oltás}."},{"t":"Adott neki {oltást} az állatorvos?"}],
"word-microchip": [{"t":"Az állatorvos {mikrochipet} ültetett a macskámba."},{"t":"A {mikrochip} segít megtalálni az elveszett háziállatokat."},{"t":"Be van jegyezve a kutyád {mikrochipje}?"}],
"word-flea": [{"t":"A kutyának {bolhái} vannak."},{"t":"A {bolhák} nagyon magasra tudnak ugrani."},{"t":"Vettünk a macskának nyakörvet a {bolhák} ellen."}],
"word-tick-insect": [{"t":"Túra után találtam egy {kullancsot} a lábamon."},{"t":"A {kullancs} megbetegítheti az embert."},{"t":"Séta után nézd meg, nincs-e {kullancs} a kutyádon."}],
"word-walk-the-dog": [{"t":"Minden reggel munka előtt {kutyát sétáltatok}."},{"t":"Vacsora után ő {kutyát sétáltat}."},{"t":"Ki fog ma este {kutyát sétáltatni}?"}],
"word-bark": [{"t":"A kutya {ugat} az idegenekre."},{"t":"A szomszéd kutyája egész éjjel {ugatott}."},{"t":"Ne {ugass} már!"}],
"word-meow": [{"t":"A macska {nyávogott} az ajtónál."},{"t":"Hallottam, hogy egy kiscica {nyávog} odakint."},{"t":"A macskám {nyávog}, ha éhes."}],
"word-tail": [{"t":"A kutya csóválta a {farkát}."},{"t":"A macskának hosszú, szürke {farka} van."},{"t":"A mókusoknak bozontos {farkuk} van."}],
"word-paw": [{"t":"A kutya odanyújtotta nekem a {mancsát}."},{"t":"A macska megnyalta a {mancsát}."},{"t":"A padlón sáros {mancsok} nyoma látszott."}],
"word-fur": [{"t":"A macskának puha, fehér {szőre} van."},{"t":"Gallérján {szőrrel} szegett kabátot viselt."},{"t":"A kutyák tavasszal sok {szőrt} hullatnak."}],
"word-feather": [{"t":"Egy kék {tollat} találtam a földön."},{"t":"A párna {tollal} van töltve."},{"t":"A madarak minden nap tisztítják a {tollaikat}."}],
"word-wing": [{"t":"A madár {szárnya} megsérült."},{"t":"A denevérek a {szárnyukkal} repülnek."},{"t":"A pillangó kinyitotta a {szárnyait}."}],
"word-beak": [{"t":"A madár egy férget vitt a {csőrében}."},{"t":"A papagájoknak erős, görbe {csőrük} van."},{"t":"A kacsának narancssárga {csőre} van."}],
"word-horn": [{"t":"A bikának éles {szarva} van."},{"t":"A kecskének két hosszú {szarva} van."},{"t":"Az orrszarvúk orrán {szarv} nő."}],
"word-deer": [{"t":"Egy {szarvast} láttunk az erdőben."},{"t":"Egy csapat {szarvas} kelt át az úton."},{"t":"A {szarvas} elszaladt, amikor meghallott minket."}],
"word-squirrel": [{"t":"Egy {mókus} diót eszik a fán."},{"t":"A {mókus} felfutott a fára."},{"t":"A {mókusok} télire diót raktároznak."}],
"word-hedgehog": [{"t":"Egy {sündisznó} labdává gömbölyödött."},{"t":"Egy {sündisznót} láttunk a kertünkben."},{"t":"A {sündisznók} nappal alszanak."}],
"word-bat-animal": [{"t":"Egy {denevér} repült ki a barlangból."},{"t":"A {denevérek} fejjel lefelé alszanak."},{"t":"A {denevérek} éjjel jönnek elő táplálékot keresni."}],
"word-camel": [{"t":"A {teve} sok napig kibírja víz nélkül."},{"t":"{Tevén} lovagoltunk a sivatagban."},{"t":"A {tevének} egy vagy két púpja van."}],
"word-giraffe": [{"t":"A {zsiráf} leveleket evett egy magas fáról."},{"t":"A {zsiráfnak} nagyon hosszú nyaka van."},{"t":"A gyerekek imádták a kis {zsiráfot}."}],
"word-zebra": [{"t":"A {zebrának} fekete-fehér csíkjai vannak."},{"t":"Egy {zebrát} láttunk az állatkertben."},{"t":"A {zebrák} átfutottak a mezőn."}],
"word-kangaroo": [{"t":"A {kenguru} átugrott az úton."},{"t":"A kis {kenguru} az anyja erszényében él."},{"t":"A {kenguruk} Ausztráliában élnek."}],
"word-panda": [{"t":"A {panda} bambuszt eszik."},{"t":"Az állatkertben van egy kis {panda}."},{"t":"A {pandák} Kínából származnak."}],
"word-crocodile": [{"t":"Egy {krokodil} feküdt a folyóban."},{"t":"Vigyázz, a {krokodil} veszélyes."},{"t":"A {krokodilnak} nagy, éles fogai vannak."}],
"word-frog": [{"t":"A {béka} beugrott a tóba."},{"t":"Egy {békát} hallottam a tó mellett."},{"t":"A {békák} víz közelében élnek."}],
"word-lizard": [{"t":"Egy kis {gyík} ült a sziklán."},{"t":"A {gyík} felfutott a falon."},{"t":"Egyes {gyíkok} színt tudnak változtatni."}],
"word-whale": [{"t":"A hajóról egy {bálnát} láttunk."},{"t":"A kék {bálna} a Föld legnagyobb állata."},{"t":"A {bálnák} nem halak."}],
"word-dolphin": [{"t":"A {delfin} kiugrott a vízből."},{"t":"A {delfinek} nagyon okos állatok."},{"t":"A gyerekek egy {delfinnel} úsztak."}],
"word-shark": [{"t":"Egy {cápa} van a vízben!"},{"t":"A {cápának} sok éles foga van."},{"t":"Fél a {cápáktól}."}],
"word-octopus": [{"t":"A {polipnak} nyolc karja van."},{"t":"Egy spanyolországi étteremben {polipot} ettünk."},{"t":"A {polip} elbújt egy szikla alatt."}],
"word-crab": [{"t":"Egy {rák} oldalazva ment a homokon."},{"t":"Vacsorára {rákot} ettünk."},{"t":"A gyerekek elkaptak egy kis {rákot}."}],
"word-eagle": [{"t":"Egy {sas} repült magasan a hegyek felett."},{"t":"A {sas} az ország jelképe."},{"t":"A {sasoknak} kiváló a látásuk."}],
"word-owl": [{"t":"Egy {bagoly} ült a fán éjjel."},{"t":"A {bagoly} elfordította a fejét."},{"t":"Hallottam egy {baglyot} az ablakom előtt."}],
"word-pigeon": [{"t":"Egy {galamb} szállt le a padra."},{"t":"Az emberek a parkban etetik a {galambokat}."},{"t":"A városban sok {galamb} van."}],
"word-crow": [{"t":"Egy fekete {varjú} ült a kerítésen."},{"t":"A {varjú} hangosan károgott."},{"t":"A {varjak} nagyon okos madarak."}],
"word-swan": [{"t":"Egy fehér {hattyú} úszott át a tavon."},{"t":"A {hattyúnak} hosszú nyaka van."},{"t":"A parkban etettük a {hattyúkat}."}],
"word-penguin": [{"t":"A {pingvin} nem tud repülni, de jól úszik."},{"t":"A {pingvinek} hideg helyeken élnek."},{"t":"Az állatkertben néztük a {pingvineket}."}],
"word-goose": [{"t":"Egy {liba} sétált át az úton."},{"t":"A {libák} télre délre repültek."},{"t":"Egy {libát} láttunk a kicsinyeivel."}],
"word-donkey": [{"t":"A gazda egy {szamáron} lovagolt."},{"t":"Egy {szamár} cipelte a zsákokat a dombra."},{"t":"A {szamárnak} hosszú füle van."}],
"word-bull": [{"t":"Ne menj a {bika} közelébe."},{"t":"A {bika} a legelőn van."},{"t":"A {bika} a piros kendő felé rohant."}],
"word-rat": [{"t":"Egy {patkányt} láttam a pincében."},{"t":"Egy {patkány} átfutott az utcán."},{"t":"A {patkányok} szinte bárhol megélnek."}],
"word-ant": [{"t":"Egy {hangya} egy morzsát cipelt."},{"t":"A {hangyák} együtt dolgoznak."},{"t":"{Hangyák} vannak a konyhában."}],
"word-mosquito": [{"t":"Tegnap éjjel megcsípett egy {szúnyog}."},{"t":"A {szúnyogok} a meleg, nedves helyeket szeretik."},{"t":"Permettel tartsd távol a {szúnyogokat}."}],
"word-cockroach": [{"t":"Egy {csótány} van a konyhában!"},{"t":"Sikoltott, amikor meglátott egy {csótányt}."},{"t":"A {csótányok} éjjel bújnak elő."}],
"word-worm": [{"t":"A madár kihúzott egy {férget} a földből."},{"t":"Horgászcsaliként {férget} használunk."},{"t":"A {férgek} a talajban élnek."}],
"word-snail": [{"t":"Egy {csiga} mászott át a levélen."},{"t":"A {csiga} nagyon lassan mozog."},{"t":"Egyesek {csigát} esznek."}],
"word-zoo": [{"t":"Vasárnap az {állatkertbe} mentünk."},{"t":"Az {állatkertben} két új panda van."},{"t":"A gyerekek szeretnek az {állatkertbe} járni."}]
}
