{
"word-landlord": [{"t":"{مُؤَجِّرُنَا} يَسْكُنُ فِي الْمَبْنَى الْمُجَاوِرِ."},{"t":"اِتَّصَلْتُ {بِالْمُؤَجِّرِ} بِشَأْنِ الْمِدْفَأَةِ الْمُعَطَّلَةِ."},{"t":"{الْمُؤَجِّرُ} لَطِيفٌ جِدًّا وَمُتَعَاوِنٌ."}],
"word-tenant": [{"t":"سَيَنْتَقِلُ {الْمُسْتَأْجِرُ} الْجَدِيدُ إِلَى الشَّقَّةِ يَوْمَ السَّبْتِ."},{"t":"يَجِبُ عَلَى كُلِّ {مُسْتَأْجِرٍ} أَنْ يَدْفَعَ فِي أَوَّلِ الشَّهْرِ."},{"t":"هِيَ {مُسْتَأْجِرَةٌ} فِي هَذَا الْمَبْنَى مُنْذُ خَمْسِ سَنَوَاتٍ."}],
"word-rent-n": [{"t":"{الْإِيجَارُ} ثَمَانِمِئَةِ دُولَارٍ فِي الشَّهْرِ."},{"t":"أَدْفَعُ {إِيجَارِي} فِي أَوَّلِ يَوْمٍ مِنَ الشَّهْرِ."},{"t":"{الْإِيجَارُ} فِي هَذِهِ الْمَدِينَةِ مُرْتَفِعٌ جِدًّا."}],
"word-deposit": [{"t":"دَفَعْنَا {وَدِيعَةَ الضَّمَانِ} بِقِيمَةِ إِيجَارِ شَهْرٍ."},{"t":"هَلْ سَأَسْتَرِدُّ {وَدِيعَةَ الضَّمَانِ} عِنْدَ الْمُغَادَرَةِ؟"},{"t":"{وَدِيعَةُ الضَّمَانِ} أَكْثَرُ مِمَّا تَوَقَّعْتُ."}],
"word-utilities": [{"t":"هَلْ {الْمَرَافِقُ} مَشْمُولَةٌ فِي الْإِيجَارِ؟"},{"t":"نَتَقَاسَمُ {الْمَرَافِقَ} مَعَ زُمَلَائِنَا فِي السَّكَنِ."},{"t":"تُكَلِّفُ {الْمَرَافِقُ} نَحْوَ مِئَةِ دُولَارٍ شَهْرِيًّا."}],
"word-utility-meter": [{"t":"{الْعَدَّادُ} فِي الطَّابِقِ السُّفْلِيِّ."},{"t":"جَاءَ رَجُلٌ لِقِرَاءَةِ {الْعَدَّادِ}."},{"t":"كَتَبْتُ الْأَرْقَامَ الَّتِي عَلَى {الْعَدَّادِ}."}],
"word-real-estate-agent": [{"t":"أَرَانَا {سِمْسَارُ الْعَقَارَاتِ} ثَلَاثَ شُقَقٍ الْيَوْمَ."},{"t":"هِيَ تَعْمَلُ {سِمْسَارَةَ عَقَارَاتٍ} فِي وَسَطِ الْمَدِينَةِ."},{"t":"اِتَّصِلْ {بِسِمْسَارِ الْعَقَارَاتِ} لِتَسْأَلَ عَنِ السِّعْرِ."}],
"word-studio-apartment": [{"t":"يَسْكُنُ فِي {شَقَّةِ اِسْتُودْيُو} صَغِيرَةٍ قُرْبَ الْمَحَطَّةِ."},{"t":"{شَقَّةُ اِسْتُودْيُو} أَرْخَصُ مِنْ شَقَّةٍ بِغُرْفَتَيْنِ."},{"t":"وَجَدْنَا {شَقَّةَ اِسْتُودْيُو} جَمِيلَةً بِنَافِذَةٍ كَبِيرَةٍ."}],
"word-furnished": [{"t":"اِسْتَأْجَرْنَا شَقَّةً {مَفْرُوشَةً} لِلصَّيْفِ."},{"t":"هَلْ غُرْفَةُ الْجُلُوسِ {مَفْرُوشَةٌ}؟"},{"t":"الشَّقَّةُ {مَفْرُوشَةٌ}، فَلَا نَحْتَاجُ إِلَى سَرِيرٍ."}],
"word-attic": [{"t":"نَحْتَفِظُ بِصَنَادِيقَ قَدِيمَةٍ فِي {الْعُلِّيَّةِ}."},{"t":"{الْعُلِّيَّةُ} حَارَّةٌ فِي الصَّيْفِ."},{"t":"وَجَدَتْ أَلْبُومَ صُوَرٍ قَدِيمًا فِي {الْعُلِّيَّةِ}."}],
"word-yard": [{"t":"الْأَطْفَالُ يَلْعَبُونَ فِي {الْفِنَاءِ}."},{"t":"لَدَيْنَا {فِنَاءٌ} صَغِيرٌ خَلْفَ الْبَيْتِ."},{"t":"يَجُزُّ الْعُشْبَ فِي {الْفِنَاءِ} كُلَّ سَبْتٍ."}],
"word-mortgage": [{"t":"حَصَلُوا عَلَى {رَهْنٍ عَقَارِيٍّ} لِشِرَاءِ الْبَيْتِ."},{"t":"قِسْطُ {الرَّهْنِ الْعَقَارِيِّ} مُسْتَحَقٌّ فِي الْخَامِسِ مِنَ الشَّهْرِ."},{"t":"سَيَسْتَغْرِقُ سَدَادُ {الرَّهْنِ الْعَقَارِيِّ} ثَلَاثِينَ سَنَةً."}],
"word-move-in": [{"t":"{سَنَنْتَقِلُ} إلى البيت الأسبوع القادم."},{"t":"متى يمكنني أن {أَنْتَقِلَ} إلى الشقة؟"},{"t":"{اِنْتَقَلَ} الجيران الجدد إلى هنا الشهر الماضي."}],
"word-move-out": [{"t":"علينا أن {نُخْلِيَ} الشقة قبل نهاية الشهر."},{"t":"يريد زميلي أن {يُخْلِيَ} الغرفة."},{"t":"{أَخْلَوْا} الشقة في نهاية الأسبوع الماضي."}],
"word-viewing": [{"t":"لَدَيْنَا {مُعَايَنَةٌ} لِلشَّقَّةِ غَدًا فِي الْعَاشِرَةِ."},{"t":"بَعْدَ {الْمُعَايَنَةِ}، قَرَّرْنَا أَنْ نَأْخُذَ الشَّقَّةَ."},{"t":"هَلْ يُمْكِنُ تَرْتِيبُ {مُعَايَنَةٍ} لِهَذَا الْأُسْبُوعِ؟"}],
"word-square-meter": [{"t":"مساحة الغرفة عشرون {مِتْرًا مُرَبَّعًا}."},{"t":"مساحة هذه الشقة ستون {مِتْرًا مُرَبَّعًا}."},{"t":"السعر ألفا دولار لكل {مِتْرٍ مُرَبَّعٍ}."}],
"word-bedroom": [{"t":"تَحْتَوِي شَقَّتُنَا عَلَى {غُرْفَتَيْ نَوْمٍ}."},{"t":"{غُرْفَةُ النَّوْمِ} هَادِئَةٌ وَمُظْلِمَةٌ لَيْلًا."},{"t":"هِيَ تُنَظِّفُ {غُرْفَةَ نَوْمِهَا}."}],
"word-living-room": [{"t":"نُشَاهِدُ التِّلْفَازَ فِي {غُرْفَةِ الْجُلُوسِ}."},{"t":"{غُرْفَةُ الْجُلُوسِ} فِيهَا أَرِيكَةٌ كَبِيرَةٌ."},{"t":"ضُيُوفُنَا يَنْتَظِرُونَ فِي {غُرْفَةِ الْجُلُوسِ}."}],
"word-dining-room": [{"t":"الْعَشَاءُ جَاهِزٌ فِي {غُرْفَةِ الطَّعَامِ}."},{"t":"لَدَيْنَا طَاوِلَةٌ كَبِيرَةٌ فِي {غُرْفَةِ الطَّعَامِ}."},{"t":"{غُرْفَةُ الطَّعَامِ} بِجَانِبِ الْمَطْبَخِ."}],
"word-intercom": [{"t":"اِضْغَطْ عَلَى الزِّرِّ فِي {الْإِنْتَرْكُومِ}."},{"t":"سَمِعْتُ صَوْتَهُ عَبْرَ {الْإِنْتَرْكُومِ}."},{"t":"{الْإِنْتَرْكُومُ} مُعَطَّلٌ، لِذَلِكَ اِتَّصِلْ بِي."}],
"word-floor-plan": [{"t":"هَلْ أَسْتَطِيعُ رُؤْيَةَ {مُخَطَّطِ الطَّابِقِ} لِهَذِهِ الشَّقَّةِ؟"},{"t":"يُبَيِّنُ {مُخَطَّطُ الطَّابِقِ} غُرْفَتَيْنِ لِلنَّوْمِ وَمَطْبَخًا."},{"t":"رَسَمَ {مُخَطَّطَ الطَّابِقِ} لِلْبَيْتِ."}],
"word-housing-n": [{"t":"{السَّكَنُ} غال جدا في هذه المدينة."},{"t":"تساعد الشركة الطلاب في إيجاد {سَكَنٍ}."},{"t":"نبحث عن {سَكَنٍ} رخيص."}]
}
